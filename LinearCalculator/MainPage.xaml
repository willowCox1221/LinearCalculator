<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.MainPage"
             Title="Linear Algebra Calculator">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label
                Text="Linear Algebra Calculator"
                FontSize="24"
                HorizontalOptions="Center" />

            <Button Text="Unit 1"
                    Clicked="OnUnit1Clicked" />

            <Button Text="Unit 2" Clicked="OnUnit2Clicked"/>

            <Button Text="Unit 3" Clicked="OnUnit3Clicked" />

            <Button Text="Unit 4" Clicked="OnUnit4Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>