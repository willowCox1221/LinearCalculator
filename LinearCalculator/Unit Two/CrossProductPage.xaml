<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.Unit_Two.CrossProductPage"
             Title="Cross Product">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Vector A (3D only):"
                   FontAttributes="Bold"/>
            <Entry x:Name="VectorAInput"
                   Placeholder="Example: 1 2 3"/>

            <Label Text="Vector B (3D only):"
                   FontAttributes="Bold"/>
            <Entry x:Name="VectorBInput"
                   Placeholder="Example: 4 5 6"/>

            <Button Text="Compute Cross Product"
                    Clicked="OnCrossProductClicked"/>

            <Label Text="Steps:"
                   FontAttributes="Bold"/>

            <Label x:Name="ResultLabel"
                   LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>