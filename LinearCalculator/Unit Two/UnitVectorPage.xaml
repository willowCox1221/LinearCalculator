<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.Unit_Two.UnitVectorPage"
             Title="Unit Vector">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Find the Unit Vector"
                   FontSize="22"
                   HorizontalOptions="Center"/>

            <Label Text="Vector (x, y, z)" FontAttributes="Bold"/>

            <Entry x:Name="VectorX" Placeholder="X"/>
            <Entry x:Name="VectorY" Placeholder="Y"/>
            <Entry x:Name="VectorZ" Placeholder="Z"/>

            <Button Text="Calculate Unit Vector"
                    Clicked="OnUnitVectorClicked"/>

            <Label x:Name="MagnitudeLabel"
                   Text="Magnitude:"
                   FontSize="18"/>

            <Label x:Name="ResultLabel"
                   Text="Unit Vector:"
                   FontSize="18"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>