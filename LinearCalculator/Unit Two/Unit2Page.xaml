<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.Unit2Page"
             Title="Unit2Page">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
            Text="Unit 2: Vector"
            FontSize="22"
            HorizontalOptions="Center" />

            <Button Text="Vector" Clicked="OnVectorClicked"/>
            <Button Text="Unit Vector" Clicked="OnUnitVectorClicked"/>
            <Button Text="Cross Product" Clicked="OnCrossProductClicked"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>