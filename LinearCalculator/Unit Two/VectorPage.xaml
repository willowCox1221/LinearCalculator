<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.Unit_Two.VectorPage"
             Title="Vector Calculator">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Vector A (space separated):"
                   FontAttributes="Bold"/>
            <Entry x:Name="VectorAInput"
                   Placeholder="Example: 1 2 3"/>

            <Label Text="Vector B (optional):"
                   FontAttributes="Bold"/>
            <Entry x:Name="VectorBInput"
                   Placeholder="Example: 4 5 6"/>

            <Label Text="Scalar (optional):"
                   FontAttributes="Bold"/>
            <Entry x:Name="ScalarInput"
                   Placeholder="Example: 3"/>

            <Button Text="Add Vectors"
                    Clicked="OnAddClicked"/>

            <Button Text="Subtract Vectors"
                    Clicked="OnSubtractClicked"/>

            <Button Text="Dot Product"
                    Clicked="OnDotProductClicked"/>

            <Button Text="Magnitude of A"
                    Clicked="OnMagnitudeClicked"/>

            <Button Text="Scalar Multiply A"
                    Clicked="OnScalarMultiplyClicked"/>
            
            <Button Text="Angle" Clicked="OnAngleClicked"/>
            
            <Button Text="Projection of A onto B"
                    Clicked="OnProjectionClicked"/>

            <Label Text="Result:"
                   FontAttributes="Bold"/>

            <Label x:Name="ResultLabel"
                   LineBreakMode="WordWrap"/>
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>