<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LinearCalculator.Unit_One.TransposePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Matrix Transpose">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Matrix Transpose"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Label Text="Enter Matrix (rows on new lines, space separated):" />

            <Editor x:Name="MatrixInput"
                    HeightRequest="150"
                    AutoSize="TextChanges"
                    Placeholder="Example:
1 2 3
4 5 6" />

            <Button Text="Transpose Matrix"
                    Clicked="OnTransposeClicked"
                    BackgroundColor="#5A2FC2"
                    TextColor="White" />

            <Label Text="Steps:"
                   FontAttributes="Bold" />

            <Label x:Name="StepsLabel"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>