<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.Unit_One.EliminationPage"
             Title="Gaussian Elimination"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Title -->
            <Label Text="Gaussian Elimination"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#333"/>

            <!-- Subtitle -->
            <Label Text="Reduce a matrix to RREF step-by-step"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray"/>

            <!-- Input Card -->
            <Frame CornerRadius="12"
                   Padding="15"
                   BackgroundColor="White"
                   BorderColor="#E0E0E0">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Matrix Input"
                           FontAttributes="Bold"
                           FontSize="16"/>

                    <Label Text="Enter rows separated by new lines. Use spaces between numbers."
                           FontSize="13"
                           TextColor="Gray"/>

                    <Editor x:Name="MatrixInput"
                            Placeholder="Example:
1 2 3
4 5 6
7 8 9"
                            AutoSize="TextChanges"
                            HeightRequest="140"
                            BackgroundColor="#FAFAFA"
                            FontFamily="Courier New"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Button -->
            <Button Text="Perform Elimination"
                    Clicked="OnEliminateClicked"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="55"
                    CornerRadius="12"
                    BackgroundColor="#4CAF50"
                    TextColor="White"/>

            <!-- Steps Header -->
            <Label Text="Step-by-Step Solution"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#333"/>

            <!-- Steps Container (UPGRADED) -->
            <VerticalStackLayout x:Name="StepsContainer"
                                 Spacing="12"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>