<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.Unit_One.CramersRule"
             Title="CramersRule">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Cramer's Rule Calculator (2x2)" FontSize="20"/>

            <Picker x:Name="ModePicker" SelectedIndexChanged="OnModeChanged">
                <Picker.Items>
                    <x:String>2x2</x:String>
                    <x:String>3x3</x:String>
                </Picker.Items>
            </Picker>

            <Grid x:Name="TwoByTwoLayout"            
                  ColumnDefinitions="*,*,Auto,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="5"
                  RowSpacing="5">
     

                <!-- Row 1 -->
                <Entry x:Name="EntryA" Grid.Row="0" Grid.Column="0" WidthRequest="50"/>
                <Entry x:Name="EntryB" Grid.Row="0" Grid.Column="1" WidthRequest="50"/>

                <Label Text="|" Grid.Row="0" Grid.Column="2" FontSize="20" VerticalOptions="Center"/>

                <Entry x:Name="EntryE" Grid.Row="0" Grid.Column="3" WidthRequest="50"/>

                <!-- Row 2 -->
                <Entry x:Name="EntryC" Grid.Row="1" Grid.Column="0" WidthRequest="50"/>
                <Entry x:Name="EntryD" Grid.Row="1" Grid.Column="1" WidthRequest="50"/>

                <Label Text="|" Grid.Row="1" Grid.Column="2" FontSize="20" VerticalOptions="Center"/>

                <Entry x:Name="EntryF" Grid.Row="1" Grid.Column="3" WidthRequest="50"/>

            </Grid>

            <!--This is the 3x3 layout in grid format :> Duh-->
            <Grid x:Name="ThreeByThreeLayout"
                  IsVisible="False"
                  ColumnDefinitions="*,*,*,Auto,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="5"
                  RowSpacing="5">

                <!-- Row 1 -->
                <Entry x:Name="A" Grid.Row="0" Grid.Column="0" WidthRequest="50"/>
                <Entry x:Name="B" Grid.Row="0" Grid.Column="1" WidthRequest="50"/>
                <Entry x:Name="C" Grid.Row="0" Grid.Column="2" WidthRequest="50"/>

                <Label Text="|" Grid.Row="0" Grid.Column="3" FontSize="20" VerticalOptions="Center"/>

                <Entry x:Name="Dval" Grid.Row="0" Grid.Column="4" WidthRequest="50"/>

                <!-- Row 2 -->
                <Entry x:Name="E" Grid.Row="1" Grid.Column="0" WidthRequest="50"/>
                <Entry x:Name="F" Grid.Row="1" Grid.Column="1" WidthRequest="50"/>
                <Entry x:Name="G" Grid.Row="1" Grid.Column="2" WidthRequest="50"/>

                <Label Text="|" Grid.Row="1" Grid.Column="3" FontSize="20" VerticalOptions="Center"/>

                <Entry x:Name="H" Grid.Row="1" Grid.Column="4" WidthRequest="50"/>

                <!-- Row 3 -->
                <Entry x:Name="I" Grid.Row="2" Grid.Column="0" WidthRequest="50"/>
                <Entry x:Name="J" Grid.Row="2" Grid.Column="1" WidthRequest="50"/>
                <Entry x:Name="K" Grid.Row="2" Grid.Column="2" WidthRequest="50"/>

                <Label Text="|" Grid.Row="2" Grid.Column="3" FontSize="20" VerticalOptions="Center"/>

                <Entry x:Name="L" Grid.Row="2" Grid.Column="4" WidthRequest="50"/>

            </Grid>

            <Label x:Name="ResultLabel" FontSize="18" TextColor="Blue"/>

            <!-- Steps -->
            <Label Text="Steps:" FontAttributes="Bold"/>
            <Label x:Name="StepsLabel" FontSize="16"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>