<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LinearCalculator.Unit_Three.OrthogonalCheckPage"
             Title="OrthogonalCheckPage">
    <VerticalStackLayout>
        <Entry x:Name="A1" Placeholder="A₁"/>
        <Entry x:Name="A2" Placeholder="A₂"/>
        <Entry x:Name="A3" Placeholder="A₃"/>

        <Entry x:Name="B1" Placeholder="B₁"/>
        <Entry x:Name="B2" Placeholder="B₂"/>
        <Entry x:Name="B3" Placeholder="B₃"/>

        <Button Text="Check Orthogonal"
        Clicked="OnCheckOrthogonalClicked"/>

        <Label x:Name="ResultLabel"/>
    </VerticalStackLayout>
</ContentPage>